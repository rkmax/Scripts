#!/usr/bin/env python3

from __future__ import annotations

import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import Any


CONFIG_DIR_PREFIX = ".claude"
ACCOUNT_COLORS = {"personal": 39, "work": 208}


def config_dir(payload: dict[str, Any]) -> Path | None:
    env_dir = os.environ.get("CLAUDE_CONFIG_DIR")
    if env_dir:
        return Path(env_dir).expanduser()
    transcript = payload.get("transcript_path")
    if not isinstance(transcript, str) or not transcript:
        return None
    parts = Path(transcript).expanduser().parts
    if "projects" not in parts:
        return None
    return Path(*parts[: parts.index("projects")])


def account_label(payload: dict[str, Any]) -> str:
    directory = config_dir(payload)
    if directory is None:
        return "personal"
    return directory.name.removeprefix(CONFIG_DIR_PREFIX).lstrip("-") or "personal"


def account_badge(label: str) -> str:
    color = ACCOUNT_COLORS.get(label, 245)
    return f"\x1b[48;5;{color}m\x1b[38;5;16m {label.upper()} \x1b[0m"


def cache_path(payload: dict[str, Any]) -> Path:
    raw_path = os.environ.get("CLAUDE_STATUSLINE_CACHE")
    if raw_path:
        return Path(raw_path).expanduser().resolve()
    directory = config_dir(payload) or Path("~/.claude")
    return (directory / "statusline-cache.json").expanduser().resolve()


def read_payload() -> dict[str, Any]:
    raw_input = sys.stdin.read()
    if not raw_input.strip():
        return {}
    try:
        payload = json.loads(raw_input)
    except json.JSONDecodeError:
        return {}
    return payload if isinstance(payload, dict) else {}


def nested_get(payload: dict[str, Any], *keys: str) -> Any:
    current: Any = payload
    for key in keys:
        if not isinstance(current, dict):
            return None
        current = current.get(key)
    return current


def write_cache(payload: dict[str, Any]) -> None:
    if not payload:
        return

    output_path = cache_path(payload)
    snapshot = {
        "captured_at_epoch": int(datetime.now().astimezone().timestamp()),
        "captured_at_local": datetime.now().astimezone().strftime(
            "%Y-%m-%d %H:%M:%S %Z"
        ),
        "version": payload.get("version"),
        "account": account_label(payload),
        "session_id": payload.get("session_id"),
        "session_name": payload.get("session_name"),
        "transcript_path": payload.get("transcript_path"),
        "model": payload.get("model"),
        "workspace": payload.get("workspace"),
        "context_window": payload.get("context_window"),
        "rate_limits": payload.get("rate_limits"),
    }

    try:
        output_path.parent.mkdir(parents=True, exist_ok=True)
        tmp_path = output_path.with_suffix(f"{output_path.suffix}.tmp")
        tmp_path.write_text(json.dumps(snapshot, indent=2) + "\n", encoding="utf-8")
        tmp_path.replace(output_path)
    except OSError:
        pass


def git_branch(cwd: str) -> str:
    if not cwd:
        return ""
    try:
        result = subprocess.run(
            ["git", "-C", cwd, "branch", "--show-current"],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=0.2,
        )
    except Exception:  # noqa: BLE001
        return ""
    return result.stdout.strip()


def print_statusline(payload: dict[str, Any]) -> None:
    cwd = str(
        nested_get(payload, "workspace", "current_dir")
        or payload.get("cwd")
        or os.getcwd()
    )
    model = str(nested_get(payload, "model", "display_name") or "Claude")
    project = Path(cwd).name or cwd
    branch = git_branch(cwd)
    marker = "\U0001f788"
    badge = account_badge(account_label(payload))
    if branch:
        print(f"{badge} {marker} {project} [{branch}] {model}", end="")
    else:
        print(f"{badge} {marker} {project} {model}", end="")


def main() -> int:
    payload = read_payload()
    write_cache(payload)
    print_statusline(payload)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
