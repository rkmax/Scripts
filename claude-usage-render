  rows.forEach(function (r) {
    var line = h('div', 't-row');
    if (r.color) {
      var key = h('span', 't-key');
      key.style.background = r.color;
      line.appendChild(key);
    }
    line.appendChild(h('span', 't-val', r.value));
    line.appendChild(h('span', 't-name', r.name));
