#!/usr/bin/env python3
"""Claude Code model usage: self-contained HTML dashboard.

  claude-usage-render [--out PATH] [--data-dir DIR]

Reads the history written by `claude-usage snapshot` (daily.jsonl,
sessions.jsonl) and renders one offline HTML file: model mix over time,
main/sub routing per model, and the heaviest sessions. No network, no
external assets: the data is embedded and every chart is inline SVG.
"""
from __future__ import annotations

import argparse
import collections
import datetime as dt
import json
import os
import re
import sys

DATA_DIR = os.path.expanduser("~/.local/share/claude-usage")
TOKEN_FIELDS = ("input", "output", "cache_creation", "cache_read")

# Categorical slots 1-7 of the validated palette. Slot 8 is reserved for the
# main/sub role accent so a role colour never impersonates a model colour.
# Validated with dataviz/scripts/validate_palette.js in both modes:
#   light  #2a78d6,#eb6834,#1baf7a,#eda100,#e87ba4,#008300,#4a3aa7  -> all pass
#   dark   #3987e5,#d95926,#199e70,#c98500,#d55181,#008300,#9085e9  -> all pass
MODEL_SLOTS = 7
# A model below this share of all recorded requests folds into "otros".
FOLD_SHARE = 0.005


def load_jsonl(path):
    if not os.path.exists(path):
        return []
    rows = []
    with open(path, errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except ValueError:
                continue
    return rows


def model_label(model: str) -> str:
    """claude-haiku-4-5-20251001 -> haiku 4.5 ; <synthetic> -> synthetic."""
    if not model:
        return "?"
    if model.startswith("<") and model.endswith(">"):
        return model[1:-1]
    name = re.sub(r"-20\d{6}$", "", model.replace("claude-", ""))
    head, _, tail = name.partition("-")
    return f"{head} {tail.replace('-', '.')}".strip() if tail else head


def model_family(model: str) -> str:
    if model.startswith("<"):
        return "otro"
    return re.sub(r"-20\d{6}$", "", model.replace("claude-", "")).split("-")[0]


def build_models(daily):
    """Freeze one colour slot per model, ranked over the whole history.

    The ranking is computed once from every row so a filter can never
    repaint a model: slots are stable across granularity, account and range.
    """
    reqs = collections.Counter()
    for r in daily:
        reqs[r.get("model", "?")] += r.get("reqs", 0)
    total = sum(reqs.values()) or 1
    ranked = [m for m, n in reqs.most_common() if n / total >= FOLD_SHARE]
    kept = ranked[:MODEL_SLOTS]
    folded = [m for m in reqs if m not in kept]

    classes = [{"ids": [m], "label": model_label(m), "family": model_family(m),
                "slot": i + 1} for i, m in enumerate(kept)]
    if folded:
        classes.append({"ids": sorted(folded), "label": "otros",
                        "family": "otro", "slot": 0})
    index = {}
    for i, c in enumerate(classes):
        for m in c["ids"]:
            index[m] = i
    return classes, index


def build_agents(daily):
    """Sub-agent types, ranked by requests. `-` is the main agent (no type).

    `?` means the parent transcript was already pruned, so the request could
    not be attributed. It stays a category of its own.
    """
    reqs = collections.Counter()
    for r in daily:
        if r.get("role") == "sub":
            reqs[r.get("agent") or "?"] += r.get("reqs", 0)
    order = [a for a, _ in reqs.most_common()]
    labels = ["sin atribuir" if a == "?" else a for a in order]
    return labels, {a: i for i, a in enumerate(order)}


def build_payload(daily, sessions):
    classes, midx = build_models(daily)
    agent_labels, agidx = build_agents(daily)
    accounts = sorted({r.get("account", "?") for r in daily}
                      | {s.get("account", "?") for s in sessions})
    aidx = {a: i for i, a in enumerate(accounts)}
    fallback = len(classes) - 1 if classes else 0

    # Family travels next to the colour class on purpose: the fold merges rare
    # models of different families into "otros", so a class can no longer
    # answer "is this an Opus request".
    families, fmidx = [], {}

    def family_id(model):
        fam = model_family(model)
        if fam not in fmidx:
            fmidx[fam] = len(families)
            families.append(fam)
        return fmidx[fam]

    # Collapse project away: no chart slices by project, and dropping it keeps
    # the embedded daily table small even with the agent dimension added.
    agg = collections.defaultdict(lambda: [0, 0, 0, 0, 0])
    for r in daily:
        sub = r.get("role") == "sub"
        key = (r.get("date", ""), aidx.get(r.get("account"), 0),
               midx.get(r.get("model"), fallback),
               family_id(r.get("model") or "?"),
               1 if sub else 0,
               agidx.get(r.get("agent") or "?", -1) if sub else -1)
        cell = agg[key]
        cell[0] += r.get("reqs", 0)
        for i, f in enumerate(TOKEN_FIELDS):
            cell[i + 1] += r.get(f, 0)
    daily_rows = [list(k) + v for k, v in sorted(agg.items())]

    projects = []
    pidx = {}

    def project_id(name):
        if name not in pidx:
            pidx[name] = len(projects)
            projects.append(name)
        return pidx[name]

    session_rows = []
    for s in sessions:
        mix = collections.Counter()
        for model, n in (s.get("models") or {}).items():
            mix[midx.get(model, fallback)] += n
        session_rows.append([
            s.get("date", ""),
            aidx.get(s.get("account"), 0),
            (s.get("session") or "")[:8],
            round(float(s.get("active_minutes") or 0), 1),
            round(float(s.get("minutes") or 0), 1),
            s.get("reqs", 0),
            s.get("sub_reqs", 0),
            [project_id(p) for p in (s.get("projects") or [])],
            sorted(mix.items()),
            s.get("input", 0), s.get("output", 0),
            s.get("cache_creation", 0), s.get("cache_read", 0),
        ])
    session_rows.sort(key=lambda r: r[0])

    dates = [r[0] for r in daily_rows] + [r[0] for r in session_rows]
    return {
        "generated": dt.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M"),
        "min": min(dates) if dates else "",
        "max": max(dates) if dates else "",
        "models": [{"label": c["label"], "family": c["family"], "slot": c["slot"]}
                   for c in classes],
        "agents": agent_labels,
        "families": families,
        "accounts": accounts,
        "projects": projects,
        "daily": daily_rows,
        "sessions": session_rows,
    }


