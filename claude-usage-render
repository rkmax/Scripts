      var sep = node(svg, 'path', {d: 'M' + pts.join('L'), fill: 'none'});
      sep.style.stroke = 'var(--surface)';
      sep.style.strokeWidth = '2';
    }
  }

  // x axis
  var every = Math.max(1, Math.ceil(n / Math.max(2, Math.floor(pw / 64))));
  for (var t2 = 0; t2 < n; t2 += every) {
