/* ---------- sessions ---------- */
function sessionKey(s, key) {
  if (key === 'reqs') return s[S_REQS];
  if (key === 'output') return s[S_OUT];
  if (key === 'active') return s[S_ACT];
  if (key === 'rate') return s[S_ACT] >= 5 ? (s[S_IN] + s[S_CC] + s[S_CR]) / (s[S_ACT] / 60) : -1;
  return s[S_IN] + s[S_CC] + s[S_CR];
}
function mixBar(mix, reqs, maxReqs) {
  var host = document.createElement('div');
  var W = 150, H = 12;
  var svg = mkSvg(host, W, H);
  var width = maxReqs ? Math.max(2, (reqs / maxReqs) * W) : 0;
  var x = 0, total = 0;
  mix.forEach(function (m) { total += m[1]; });
  mix.forEach(function (m, i) {
    var w = total ? (m[1] / total) * width : 0;
    if (w <= 0) return;
    var seg = node(svg, 'path', {d: capPath(x, 0, Math.max(0.8, w - (i === mix.length - 1 ? 0 : 2)), H, i === mix.length - 1 ? 4 : 0, 'right')});
    seg.style.fill = SLOT_VAR[D.models[m[0]].slot];
    var t = document.createElementNS(svg.NS, 'title');
    t.textContent = D.models[m[0]].label + ': ' + fmtNum(m[1]) + ' requests';
    seg.appendChild(t);
    x += w;
  });
  return host;
}
