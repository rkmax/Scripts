var S_DATE = 0, S_ACC = 1, S_ID = 2, S_ACT = 3, S_TOT = 4, S_REQS = 5, S_SUB = 6,
    S_PROJ = 7, S_MIX = 8, S_IN = 9, S_OUT = 10, S_CC = 11, S_CR = 12;

var state = {gran: 'week', account: 'all', range: '90', metric: 'reqs', sort: 'read', top: '20'};

/* ---------- formatting ---------- */
