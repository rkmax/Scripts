      marks.push(function () { open(anchorOf(seg)); });
      x += (v / domain) * pw;
      drawn += v;
    });
    var subShare = r.total ? r.role[1].reqs / r.total : 0;
    txt(svg, M.l + (drawn / domain) * pw + 8, y + barH / 2 + 4,
        fmtPct(subShare) + ' sub', {color: 'var(--ink-2)', size: 11.5});
  });
  keyboardMarks(host, marks);
}

