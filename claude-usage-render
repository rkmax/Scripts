  });

  var y = M.t, marks = [];
  groups.forEach(function (g) {
    txt(svg, M.l, y + 11, g.label, {color: 'var(--ink)', size: 12, weight: '600', tabular: false});
    y += headH;
    g.bars.forEach(function (b) {
