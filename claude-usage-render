    var px = function (i) { return M.l + (n === 1 ? pw / 2 : (i / (n - 1)) * pw); };
    for (var a = 0; a < series.length; a++) {
      var top = [], bot = [];
      for (var j = 0; j < n; j++) {
        var lower = a === 0 ? 0 : cum[a - 1][j];
