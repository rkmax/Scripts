        {anchor: 'end', color: 'var(--ink)', size: 12, tabular: false});
    var x = M.l, drawn = 0;
    var last = r.role[1].reqs > 0 ? 1 : 0;
    ROLE.forEach(function (role, ri) {
      var v = r.role[ri].reqs;
      if (!v) return;
      var w = (v / domain) * pw - (ri === last ? 0 : 2);
      if (w < 0.8) w = 0.8;
      var seg = node(svg, 'path', {d: capPath(x, y, w, barH, ri === last ? 4 : 0, 'right')});
      seg.style.fill = role.color;
      var det = [
        {color: role.color, name: role.label + ' - requests', value: fmtNum(v)},
        {name: 'output/request', value: fmtNum(r.role[ri].out / v)},
        {name: 'contexto/request', value: fmtTok(r.role[ri].read / v)}
