/* ---------- KPIs ---------- */
function sparkline(values, color) {
  var host = document.createElement('div');
  var W = 130, H = 26;
  var svg = mkSvg(host, W, H);
  if (values.length < 2) return host;
  var max = Math.max.apply(null, values) || 1;
  var pts = values.map(function (v, i) {
    return (i / (values.length - 1)) * (W - 6) + 3 + ' ' + (H - 3 - (v / max) * (H - 8));
  });
  var line = node(svg, 'path', {d: 'M' + pts.join('L'), fill: 'none'});
  line.style.stroke = 'var(--spark)';
  line.style.strokeWidth = '2';
  line.style.strokeLinejoin = 'round';
  line.style.strokeLinecap = 'round';
  var last = pts[pts.length - 1].split(' ');
  var dot = node(svg, 'circle', {cx: last[0], cy: last[1], r: 4});
  dot.style.fill = color;
  dot.style.stroke = 'var(--surface)';
  dot.style.strokeWidth = '2';
  return host;
}
function stripBar(parts, colors) {
  var host = document.createElement('div');
  var W = 220, H = 8;
  var svg = mkSvg(host, W, H);
  svg.setAttribute('width', '100%');
  svg.setAttribute('preserveAspectRatio', 'none');
  var total = parts.reduce(function (a, b) { return a + b; }, 0);
  if (!total) return host;
  var x = 0, lastIdx = -1;
  parts.forEach(function (v, i) { if (v > 0) lastIdx = i; });
  parts.forEach(function (v, i) {
    if (v <= 0) return;
    var w = (v / total) * W;
    var seg = node(svg, 'path', {d: capPath(x, 0, Math.max(0.8, w - (i === lastIdx ? 0 : 2)), H, i === lastIdx ? 3 : 0, 'right')});
    seg.style.fill = colors[i];
    x += w;
  });
  return host;
}
function kpiCard(cls, label, value, note, extra) {
  var card = h('div', 'kpi' + (cls ? ' ' + cls : ''));
  card.appendChild(h('div', 'label', label));
  card.appendChild(h('div', 'value', value));
  if (note) card.appendChild(h('div', 'note', note));
  if (extra) {
    var box = h('div', 'strip');
    box.appendChild(extra);
    card.appendChild(box);
  }
  return card;
}
function renderKpis(host, sl, ts) {
  clear(host);
  var tot = {reqs: 0, sub: 0, out: 0, read: 0};
  var subByFamily = {}, subTotal = 0;
  var perModel = D.models.map(function () { return {reqs: 0, read: 0}; });
  sl.daily.forEach(function (r) {
    tot.reqs += r[R_REQS];
    tot.out += r[R_OUT];
    tot.read += readOf(r);
    perModel[r[R_MOD]].reqs += r[R_REQS];
    perModel[r[R_MOD]].read += readOf(r);
    if (r[R_ROLE] === 1) {
      tot.sub += r[R_REQS];
      subTotal += r[R_REQS];
      var f = D.families[r[R_FAM]];
      subByFamily[f] = (subByFamily[f] || 0) + r[R_REQS];
    }
  });
  var opusSub = subByFamily['opus'] || 0;
  var colors = D.models.map(function (m) { return SLOT_VAR[m.slot]; });

  // 12-period trend at the current granularity.
  var sparkReqs = [], sparkRead = [];
  var tail = ts.periods.slice(-12);
  var offset = ts.periods.length - tail.length;
  for (var i = 0; i < tail.length; i++) {
    var a = 0;
    ts.series.forEach(function (s) { a += s.values[offset + i]; });
    sparkReqs.push(a);
  }

  host.appendChild(kpiCard('hero', 'Requests de subagente que corren en Opus',
    subTotal ? fmtPct(opusSub / subTotal) : '-',
    fmtNum(opusSub) + ' de ' + fmtNum(subTotal) + ' requests de subagente',
    stripBar([opusSub, subTotal - opusSub], ['var(--role-sub)', 'var(--role-sub-track)'])));

  host.appendChild(kpiCard(null, 'Requests', fmtNum(tot.reqs),
    'desglose por modelo',
    stripBar(perModel.map(function (m) { return m.reqs; }), colors)));

  host.appendChild(kpiCard(null, 'Sesiones', fmtNum(sl.sessions.length),
    'únicas, desde sessions.jsonl',
    sparkline(sparkReqs, 'var(--s1)')));

  host.appendChild(kpiCard(null, 'Requests de subagente',
    tot.reqs ? fmtPct(tot.sub / tot.reqs) : '-',
    fmtNum(tot.sub) + ' de ' + fmtNum(tot.reqs),
    stripBar([tot.sub, tot.reqs - tot.sub], ['var(--role-sub)', 'var(--role-main)'])));

  host.appendChild(kpiCard(null, 'Contexto leído', fmtTok(tot.read) + ' tok',
    'desglose por modelo',
    stripBar(perModel.map(function (m) { return m.read; }), colors)));

  host.appendChild(kpiCard(null, 'Output', fmtTok(tot.out) + ' tok',
    tot.reqs ? fmtNum(tot.out / tot.reqs) + ' tokens por request' : ''));
}

