      bar.addEventListener('pointerenter', open);
      bar.addEventListener('pointerleave', hideTip);
      marks.push(function () { open(anchorOf(bar)); });
      // Direct label: value then the model name, both in text tokens. Identity
      // never rests on hue alone - that is also the relief the light palette
      // owes for its sub-3:1 slots.
      var vLabel = txt(svg, M.l + w + 7, y + barH - 1, fmt(v), {color: 'var(--ink-2)', size: 11});
      var vw = 0;
