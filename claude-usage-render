    }
    showTip(origin, periodTitle(periods[idx], state.gran), rows,
            'Total: ' + METRICS[state.metric].fmt(totals[idx]) + ' ' + METRICS[state.metric].unit);
  }

  var overlay = node(svg, 'rect', {x: M.l, y: M.t, width: pw, height: ph, fill: 'transparent'});
  overlay.style.cursor = 'crosshair';
  overlay.addEventListener('pointermove', function (e) {
    var box = svg.getBoundingClientRect();
    var rel = e.clientX - box.left - M.l;
