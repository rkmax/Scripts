    hair.style.display = '';
    var rows = series.map(function (s) {
      return {v: s.values[idx], color: s.color, name: s.label};
    }).filter(function (r) { return r.v > 0; })
      .sort(function (a2, b2) { return b2.v - a2.v; })
      .map(function (r) {
        var share = totals[idx] ? r.v / totals[idx] : 0;
        return {color: r.color, name: r.name,
                value: normalize ? fmtPct(share) : METRICS[state.metric].fmt(r.v)};
      });
    if (!rows.length) rows = [{name: 'sin actividad', value: '-'}];
    var origin = evt || {clientX: 0, clientY: 0};
    if (!evt) {
