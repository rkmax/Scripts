      var det = [
        {color: b.color, name: label.toLowerCase() + '/request', value: fmt(v)},
        {name: 'requests', value: fmtNum(b.reqs)},
        {name: 'cache read total', value: fmtTok(b.cr)},
        {name: 'output total', value: fmtTok(b.out)}
      ];
