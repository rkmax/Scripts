function renderRoleBars(host, rows) {
  var W = Math.max(320, host.clientWidth || 640);
  var rowH = 30, barH = 16;
  var M = {t: 22, r: 62, b: 8, l: 84};
  var H = M.t + rows.length * rowH + M.b;
  var svg = mkSvg(host, W, Math.max(H, 60));
  var pw = W - M.l - M.r;
  host.setAttribute('aria-label', 'Requests por modelo repartidos entre agente principal y subagente');
  if (!rows.length) { txt(svg, M.l, 30, 'Sin datos en este rango', {color: 'var(--ink-2)', size: 13}); return; }

  var max = Math.max.apply(null, rows.map(function (r) { return r.total; })) || 1;
  var ticks = niceTicks(max, 4);
  var domain = ticks[ticks.length - 1];
  ticks.forEach(function (t) {
    var x = Math.round(M.l + (t / domain) * pw) + 0.5;
    var g = node(svg, 'line', {x1: x, x2: x, y1: M.t - 6, y2: M.t + rows.length * rowH - 6});
    g.style.stroke = t === 0 ? 'var(--axis)' : 'var(--grid)';
