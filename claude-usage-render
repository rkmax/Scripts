/* ---------- routing ---------- */
function routingRows(sl) {
  var by = {};
  sl.daily.forEach(function (r) {
    var m = r[R_MOD];
    var cell = by[m] || (by[m] = {
      i: m, label: D.models[m].label, color: SLOT_VAR[D.models[m].slot], total: 0,
      role: [{reqs: 0, out: 0, read: 0}, {reqs: 0, out: 0, read: 0}]
    });
    var role = cell.role[r[R_ROLE]];
    role.reqs += r[R_REQS];
    role.out += r[R_OUT];
    role.read += readOf(r);
    cell.total += r[R_REQS];
