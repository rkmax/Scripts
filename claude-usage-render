  var accIdx = acc === 'all' ? -1 : D.accounts.indexOf(acc);
  var daily = [], sessions = [];
  var i, r;
  for (i = 0; i < D.daily.length; i++) {
    r = D.daily[i];
    if (r[R_DATE] < from) continue;
    if (accIdx >= 0 && r[R_ACC] !== accIdx) continue;
    daily.push(r);
  }
  for (i = 0; i < D.sessions.length; i++) {
    r = D.sessions[i];
    if (r[S_DATE] < from) continue;
