function modelItems(used) {
  return D.models.map(function (m, i) { return {i: i, label: m.label, color: SLOT_VAR[m.slot]}; })
                 .filter(function (m) { return !used || used[m.i]; });
}

/* ---------- stacked time chart ---------- */
function buildTimeSeries(sl) {
  var gran = state.gran, metric = state.metric;
  var periods = periodSequence(sl.from, sl.to, gran);
  var pos = Object.create(null);
  periods.forEach(function (p, i) { pos[p] = i; });
  var series = D.models.map(function (m, i) {
    return {i: i, label: m.label, color: SLOT_VAR[m.slot],
            values: new Array(periods.length).fill(0)};
  });
  var used = {};
  sl.daily.forEach(function (r) {
    var p = pos[periodOf(r[R_DATE], gran)];
    if (p === undefined) return;
    var v = metricOf(r, metric);
    if (!v) return;
    series[r[R_MOD]].values[p] += v;
    used[r[R_MOD]] = 1;
  });
  return {periods: periods, series: series.filter(function (s) { return used[s.i]; }), used: used};
}

function renderTimeChart(host, data, normalize) {
  var periods = data.periods, series = data.series;
  var W = Math.max(320, host.clientWidth || 640);
  var H = 250;
  var M = {t: 10, r: 14, b: 30, l: 54};
  var pw = W - M.l - M.r, ph = H - M.t - M.b;
  var svg = mkSvg(host, W, H);
  var n = periods.length;
  var fmt = normalize ? fmtPct : METRICS[state.metric].fmt;
  host.setAttribute('aria-label',
    (normalize ? 'Mix de modelos' : METRICS[state.metric].label + ' por modelo') +
    ', ' + n + ' periodos, ' + series.length + ' modelos');

  if (!n || !series.length) {
    txt(svg, M.l, H / 2, 'Sin datos en este rango', {color: 'var(--ink-2)', size: 13});
    return;
  }

  var totals = new Array(n).fill(0);
  series.forEach(function (s) { s.values.forEach(function (v, i) { totals[i] += v; }); });
  var maxTotal = Math.max.apply(null, totals) || 1;
  var ticks = normalize ? [0, 0.25, 0.5, 0.75, 1] : niceTicks(maxTotal, 4);
  var domain = normalize ? 1 : ticks[ticks.length - 1];
  var y = function (v) { return M.t + ph - (v / domain) * ph; };

  ticks.forEach(function (t) {
    var yy = Math.round(y(t)) + 0.5;
    var g = node(svg, 'line', {x1: M.l, x2: M.l + pw, y1: yy, y2: yy});
    g.style.stroke = t === 0 ? 'var(--axis)' : 'var(--grid)';
    g.style.strokeWidth = '1';
    txt(svg, M.l - 8, yy + 3, fmt(t), {anchor: 'end'});
  });

  // Cumulative tops, in fixed slot order so adjacency matches the validated palette.
  var cum = series.map(function () { return new Array(n).fill(0); });
  for (var i = 0; i < n; i++) {
    var acc = 0;
    var scale = normalize ? (totals[i] || 1) : 1;
    for (var s = 0; s < series.length; s++) {
      acc += series[s].values[i] / scale;
      cum[s][i] = acc;
    }
  }

  var band = pw / n;
  var columns = n <= 60 && band >= 5;
  var GAP = 2;

  if (columns) {
    var bw = Math.max(2, Math.min(24, band - GAP));
    for (var p = 0; p < n; p++) {
      if (!totals[p]) continue;
      var x = M.l + p * band + (band - bw) / 2;
      var topIdx = -1;
      for (var k = series.length - 1; k >= 0; k--) {
        if (series[k].values[p] > 0) { topIdx = k; break; }
      }
      var below = 0;
      for (var q = 0; q < series.length; q++) {
        var val = series[q].values[p] / (normalize ? (totals[p] || 1) : 1);
        if (val <= 0) continue;
        var yTop = y(below + val), yBot = y(below);
        below += val;
        var hh = yBot - yTop - (q === topIdx ? 0 : GAP);
        if (hh < 0.6) hh = 0.6;
