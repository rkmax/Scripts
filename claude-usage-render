                     : M.l + (n === 1 ? pw / 2 : (t2 / (n - 1)) * pw);
    txt(svg, cx, H - M.b + 15, periodLabel(periods[t2], state.gran), {anchor: 'middle'});
  }

  // crosshair + tooltip (pointer and keyboard share one path)
  var hair = node(svg, 'line', {x1: 0, x2: 0, y1: M.t, y2: M.t + ph});
  hair.style.stroke = 'var(--axis)';
  hair.style.strokeWidth = '1';
  hair.style.display = 'none';
  var active = -1;

  function focusAt(idx, evt) {
