def render(payload) -> str:
    text = json.dumps(payload, ensure_ascii=False, separators=(",", ":"))
    # The payload lives in a <script type="application/json">; escaping these
    # three keeps any project name from closing the tag.
    text = (text.replace("&", "\\u0026")
                .replace("<", "\\u003c")
                .replace(">", "\\u003e"))
    return TEMPLATE.replace("__PAYLOAD__", text)


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--out", default=os.path.join(DATA_DIR, "index.html"),
                   help="ruta del HTML (por defecto %(default)s)")
    p.add_argument("--data-dir", default=DATA_DIR,
                   help="directorio con daily.jsonl y sessions.jsonl")
    args = p.parse_args()

    data_dir = os.path.expanduser(args.data_dir)
    daily = load_jsonl(os.path.join(data_dir, "daily.jsonl"))
    sessions = load_jsonl(os.path.join(data_dir, "sessions.jsonl"))
    if not daily and not sessions:
        print(f"render: sin datos en {data_dir} (¿corriste `claude-usage snapshot`?)",
              file=sys.stderr)

    out = os.path.expanduser(args.out)
    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
    tmp = out + ".tmp"
    with open(tmp, "w") as fh:
        fh.write(render(build_payload(daily, sessions)))
    os.replace(tmp, out)

    size = os.path.getsize(out)
    print(f"render: {out} ({size / 1024:.0f} KB) | "
          f"daily={len(daily):,} filas, sessions={len(sessions):,}")


main()
