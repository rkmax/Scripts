/* ---------- agents ---------- */
function agentRows(sl) {
  var by = {};
  sl.daily.forEach(function (r) {
    if (r[R_ROLE] !== 1 || r[R_AGENT] < 0) return;
    var a = r[R_AGENT];
    var cell = by[a] || (by[a] = {i: a, label: D.agents[a], reqs: 0, cr: 0, out: 0, models: {}});
    var m = cell.models[r[R_MOD]] ||
            (cell.models[r[R_MOD]] = {i: r[R_MOD], label: D.models[r[R_MOD]].label,
                                      color: SLOT_VAR[D.models[r[R_MOD]].slot],
                                      reqs: 0, cr: 0, out: 0});
    cell.reqs += r[R_REQS]; cell.cr += r[R_CR]; cell.out += r[R_OUT];
    m.reqs += r[R_REQS]; m.cr += r[R_CR]; m.out += r[R_OUT];
  });
  return Object.keys(by).map(function (k) {
    var c = by[k];
    // Segment order follows the model slot order, so stacked adjacency is
    // always the pair list the palette was validated against.
    c.mix = Object.keys(c.models).map(function (m) { return c.models[m]; })
                  .sort(function (a, b) { return a.i - b.i; });
    return c;
  }).sort(function (a, b) { return b.cr - a.cr; });
}

function renderAgentStack(host, rows) {
