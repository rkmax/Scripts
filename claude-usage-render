// daily row: [date, accountIdx, modelIdx, familyIdx, roleIdx, agentIdx,
//             reqs, input, output, cache_creation, cache_read]
var R_DATE = 0, R_ACC = 1, R_MOD = 2, R_FAM = 3, R_ROLE = 4, R_AGENT = 5,
    R_REQS = 6, R_IN = 7, R_OUT = 8, R_CC = 9, R_CR = 10;
